# Base path for the app when served from a sub-directory (e.g. GitHub Pages).
# Leave unset or set to '/' for root deployments.
# VITE_BASE_PATH=/git-code-metrics/

# URL of the backend Gitea API proxy service.
# In production, set this to your deployed Railway proxy domain, e.g.:
#   VITE_API_PROXY_URL=https://api.up.railway.app
# In local development, leave unset — defaults to '/api' so Vite can proxy
# requests to a locally running gitea-api-proxy on localhost:3000.
# VITE_API_PROXY_URL=https://api.up.railway.app
